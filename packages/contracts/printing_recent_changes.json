{
  "$comment": "Search-result overlay lookup: start Low in the 3–5 day window vs latest catalog Low for requested Printing ids only. No $1 floor, no top-10 cut, no sealed extra-filter. Web (JS) and mobile (Dart) both assert these cases. SQL fab_printing_recent_changes must emit the same rows. See packages/contracts/README.md and specs/006-trends-search-results/contracts/printing-recent-changes.md. Ranking stays in recent_movers.json.",
  "today": "2026-08-26",
  "limits": {
    "max_observed_low": 10000,
    "max_abs_percent_change": 10
  },
  "lookup_cases": [
    {
      "name": "TCG uses tcg_low, never cm_low or Market",
      "source": "tcgplayer",
      "card_ids": ["aaa-normal"],
      "snapshots_by_card": {
        "aaa-normal": [
          {
            "captured_on": "2026-08-23",
            "tcg_low": 2.0,
            "tcg_market": 9.0,
            "cm_low": 10.0
          }
        ]
      },
      "current_lows": {
        "aaa-normal": {
          "tcg_low": 4.0,
          "cm_low": 10.0,
          "is_sealed": false
        }
      },
      "expected": [
        {
          "card_id": "aaa-normal",
          "start_on": "2026-08-23",
          "start_low": 2.0,
          "latest_low": 4.0,
          "percent_change": 1.0,
          "amount_change": 2.0
        }
      ]
    },
    {
