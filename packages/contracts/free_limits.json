      "name": "a free binder accepts the fiftieth distinct card",
      "limit": "binderCards",
      "existing": 49,
      "allowed": true
    },
    {
      "name": "a free binder refuses the fifty-first",
      "limit": "binderCards",
      "existing": 50,
      "allowed": false
    },
    {
