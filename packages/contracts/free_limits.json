    "binderCards": 50,
    "wantListCards": 50,
    "savedTrades": 3,
    "loanedCards": 10,
    "binders": 4
  },
  "behaviour": {
    "binderCards": "refuse",
    "wantListCards": "refuse",
    "savedTrades": "trim-oldest",
    "loanedCards": "refuse",
    "binders": "paywall"
  },
