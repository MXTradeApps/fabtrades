{
  "$comment": "Binder-to-Binder move. Web (JS) and mobile (Dart) both assert these cases. Want List is never a destination. Shared binderCards must not refuse a valid move. See packages/contracts/README.md and specs/004-multi-binder-grid/contracts/binder-move.md.",
  "cases": [
    {
      "name": "partial quantity leaves remainder in the source Binder",
      "binders": [
        { "clientId": "system:trade", "role": "trade", "deletedAt": null },
        { "clientId": "system:collection", "role": "standard", "deletedAt": null }
      ],
      "entries": [
        {
          "printingId": "alpha-Normal",
          "name": "Alpha",
          "binderId": "system:trade",
          "isWanted": false,
          "quantity": 3,
          "condition": "NM",
          "tcgMarket": 2.0
        }
      ],
      "fromBinderId": "system:trade",
      "toBinderId": "system:collection",
      "printingId": "alpha-Normal",
      "condition": "NM",
      "quantity": 2,
      "expected": {
        "ok": true,
        "reason": null,
        "distinctOwned": 1,
        "entries": [
          {
            "printingId": "alpha-Normal",
            "binderId": "system:trade",
            "isWanted": false,
            "quantity": 1,
            "condition": "NM"
          },
          {
            "printingId": "alpha-Normal",
            "binderId": "system:collection",
            "isWanted": false,
            "quantity": 2,
            "condition": "NM"
          }
        ]
      }
    },
